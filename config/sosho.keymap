//スクロール量の調整(デフォルト150)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

/ {
	behaviors {
        ec_ms_l: ec_ms_h {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
        ec_ms_r: ec_ms_v {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };

    // ========== マクロ定義 ==========
    macros {
        // macOS 行末まで削除（Emacs Ctrl+K 相当）
        // Cmd+Shift+→ で行末まで選択 → Backspace で削除
        kill_line: kill_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT &kp LGUI>
                , <&macro_tap &kp RIGHT>
                , <&macro_release &kp LSHFT &kp LGUI>
                , <&macro_tap &kp BSPC>;
        };
    };

    // ========== Tap-Dance 定義 ==========
    // 1回タップ/長押し → Ctrl
    // ダブルタップして押し続ける → Emacs レイヤー（レイヤー4）を一時有効化
    td_ctrl_emacs: tap_dance_ctrl_emacs {
        compatible = "zmk,behavior-tap-dance";
        #binding-cells = <0>;
        tapping-term-ms = <250>;
        bindings = <&kp LCTRL>, <&mo 4>;
    };
};

//スクロールの調整
&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};

/{
    combos {
        compatible = "zmk,combos";
		//左クリックのコンボ 19はJのキー 20はKのキーに相当します。
	    combo_LCLK {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mkp LCLK>;
        };

		//右クリックのコンボ 20 K 21 L
        combo_RCLK {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp RCLK>;
        };

		//ホイールクリックのコンボ 19 J 21 L
	    combo_MCLK {
            timeout-ms = <90>;
            key-positions = <19 21>;
            bindings = <&mkp MCLK>;
        };

        // ===== 左手側マウスクリック =====
        // 左クリック S+D (14+15)
        combo_LCLK_L {
            timeout-ms = <50>;
            key-positions = <14 15>;
            bindings = <&mkp LCLK>;
        };

        // 右クリック D+F (15+16)
        combo_RCLK_L {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&mkp RCLK>;
        };

        // ホイールクリック S+F (14+16)
        combo_MCLK_L {
            timeout-ms = <90>;
            key-positions = <14 16>;
            bindings = <&mkp MCLK>;
        };

    };
};

/{
keymap {
    compatible = "zmk,keymap";

    default_layer {
        bindings = <
            &kp TAB         &kp Q   &kp W  &kp E  &kp R  &kp T      &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
            &td_ctrl_emacs  &kp A   &kp S  &kp D  &kp F  &kp G      &kp H  &kp J  &kp K      &kp L    &kp SQT   &kp ENTER
            &kp LSHFT       &kp Z   &kp X  &kp C  &kp V  &kp B      &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH &kp LSHFT
            &kp ESC         &kp LALT              &kp LGUI  &lt 2 LANG2  &kp SPACE  &lt 1 LANG1              &mo 3     &mo 3
        >;
        sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
    };
	
    layer_1 {
        bindings = <
            &trans  &trans  &kp LA(LG(N7))  &kp LA(LG(N8))  &kp LA(LG(N9))  &trans      &kp LPAR  &kp RPAR  &trans  &trans  &trans  &trans
            &trans  &trans  &kp LA(LG(N4))  &kp LA(LG(N5))  &kp LA(LG(N6))  &trans      &kp LBRC  &kp RBRC  &trans  &trans  &trans  &trans
            &trans  &trans  &kp LA(LG(N1))  &kp LA(LG(N2))  &kp LA(LG(N3))  &trans      &trans    &trans    &trans  &trans  &trans  &trans
            &trans  &trans                                  &trans          &trans      &trans    &trans                    &trans  &trans
        >;
    };

    layer_2 {
        bindings = <
            &kp BSPC  &kp LG(LC(LS(N3)))  &kp N7  &kp N8  &kp N9  &kp MINUS     &kp EQUAL  &kp N7  &kp N8  &kp N9  &kp MINUS  &kp GRAVE
            &kp RET   &kp LG(LC(LS(N4)))  &kp N4  &kp N5  &kp N6  &kp LPAR      &kp RPAR   &kp N4  &kp N5  &kp N6  &trans     &trans
            &trans    &trans              &kp N1  &kp N2  &kp N3  &kp LBRC      &kp RBRC   &kp N1  &kp N2  &kp N3  &trans     &trans
            &trans    &trans                              &kp N0  &trans        &trans     &kp N0                  &trans     &trans
        >;
		//レイヤー2のときだけ、左手のエンコーダを回すとボリュームの上下ができるようになっています。
		sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &ec_ms_r SCRL_DOWN SCRL_UP>;
    };

    layer_3 {
        bindings = <
            &kp C_VOL_UP  &trans  &kp F7  &kp F8  &kp F9  &trans      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
            &kp C_VOL_DN  &trans  &kp F4  &kp F5  &kp F6  &trans      &trans        &trans        &trans        &kp UP        &trans        &trans
            &kp C_MUTE    &trans  &kp F1  &kp F2  &kp F3  &trans      &trans        &trans        &kp LEFT      &kp DOWN      &kp RIGHT     &trans
            &trans        &trans                  &trans  &trans      &trans        &trans                                    &trans        &trans
        >;
    };

    ctrl_layer {
        bindings = <
            &trans  &trans          &trans  &kp LG(RIGHT)  &trans  &trans      &trans  &trans  &kill_line  &kp RET  &kp UP  &trans
            &trans  &kp LG(LEFT)    &trans  &kp DEL        &kp RIGHT &trans    &kp BSPC &trans &trans      &trans   &trans  &trans
            &trans  &trans          &trans  &trans         &trans  &kp LEFT    &kp DOWN &trans &trans      &trans   &trans  &trans
            &trans  &trans                                 &trans  &trans      &trans  &trans                       &trans  &trans
        >;
    };

    scroll {
        status = "reserved";
    };

    extra2 {
        status = "reserved";
    };
};
};
